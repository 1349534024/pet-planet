APP_NAME=pet-planet
APP_ENV=local
DEBUG=true
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=mysql+pymysql://pet:pet123456@127.0.0.1:3306/pet_planet
# DATABASE_URL=postgresql+psycopg://pet:pet123456@127.0.0.1:5432/pet_planet

JWT_SECRET_KEY=please-change-this-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHROMA_PERSIST_DIR=./data/chroma

OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=pet-planet
OBJECT_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8000/static

SMS_PROVIDER=mock
SMS_ACCESS_KEY=
SMS_SECRET_KEY=

# Alipay sandbox. Keep real keys only in .env.
ALIPAY_SANDBOX_APP_ID=
ALIPAY_SANDBOX_PRIVATE_KEY=
ALIPAY_SANDBOX_PUBLIC_KEY=
ALIPAY_SANDBOX_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_SANDBOX_NOTIFY_URL=http://127.0.0.1:8000/api/v1/payments/alipay/notify
ALIPAY_SANDBOX_RETURN_URL=http://127.0.0.1:8000/api/v1/payments/alipay/return
